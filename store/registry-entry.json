{
  "name": "figma",
  "label": "Figma",
  "description": "Read your Figma designs \u2014 file structure, rendered frames, and design tokens.",
  "icon": "paint-brush",
  "version": "0.1.0",
  "author": "TheBananaStand",
  "homepage": "https://github.com/TheBananaStand/leo-figma",
  "category": "package",
  "mcp": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "github:TheBananaStand/leo-figma#4405fd0533ad8c9ab6078c762db6ee4678c6be89"
    ],
    "timeout_secs": 60
  },
  "descriptor": {
    "fields": [
      {
        "key": "FIGMA_TOKEN",
        "label": "Figma personal access token",
        "field_type": "password",
        "required": true
      }
    ],
    "pages": [],
    "migrations": [],
    "entitlements": {
      "feed": false,
      "push": false,
      "settings_read": [
        "FIGMA_TOKEN"
      ],
      "network": [
        "api.figma.com"
      ],
      "sends": [
        {
          "to": "api.figma.com",
          "classes": [
            "credentials",
            "search_queries"
          ],
          "purpose": "Your Figma token, and the file key and node ids you ask about. Design data travels the other way \u2014 nothing from Leo is sent to Figma, and the package can only read."
        }
      ]
    }
  }
}
